+# Experiment A2 Configuration: Spatial + Frequency Dual-Branch Architecture
+experiment:
+  name: "a2_spatial_frequency"
+  seed: 42
+  description: "MobileNetV3-Large spatial backbone + 2D FFT learnable spectral filtering frequency branch fine-tuned on cached RAF-DB."
+
+model:
+  name: "spatial_frequency"
+  spatial_backbone: "mobilenet_v3_large"
+  pretrained: true
+  num_classes: 7
+  freq_embedding_dim: 256
+  dropout_rate: 0.2
+  input_resolution: [3, 224, 224]
+
+training:
+  epochs: 30
+  batch_size: 32
+  num_workers: 0
+  mixed_precision: true
+  early_stopping:
+    metric: "macro_f1"
+    mode: "max"
+    patience: 7
+    min_delta: 0.001
+
+optimizer:
+  type: "AdamW"
+  backbone_lr: 0.0001    # 1e-4 for pretrained spatial feature extractor
+  freq_lr: 0.001         # 1e-3 for frequency branch trained from scratch
+  head_lr: 0.001         # 1e-3 for fusion classification head
+  weight_decay: 0.01
+
+scheduler:
+  type: "cosine"
+  t_max: 30
+  eta_min: 0.000001      # 1e-6
+  warmup_epochs: 2
+
+loss:
+  type: "CrossEntropyLoss"
+  label_smoothing: 0.1
+  use_class_weights: true
+  class_weights_mode: "balanced"
+
+data:
+  use_cache: true
+  cache_dir: "data/cache/rafdb_cache"
+  parquet_path: "data/raw/raf-db/train-00000-of-00001.parquet"
+  train_manifest: "data/manifests/rafdb_train.csv"
+  val_manifest: "data/manifests/rafdb_val.csv"
+  test_manifest: "data/manifests/rafdb_test.csv"
